:root {
    --bg-crimson: #380609;       /* Rojo burdeos profundo de fondo */
    --bg-darker: #240305;        /* Sombra más oscura */
    --gold: #d4af6a;             /* Dorado viejo para marcos y acentos */
    --gold-light: #ebd197;       /* Dorado claro al pasar el cursor */
    --ivory: #f5efe6;            /* Blanco marfil para textos principales */
    --text-muted: #d1baba;       /* Rosa/gris pálido para descripciones */
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background-color: var(--bg-crimson);
    color: var(--ivory);
    font-family: 'Cormorant Garamond', Georgia, serif;
    line-height: 1.6;
}

/* --- ENCABEZADO SUPERIOR --- */
.navbar {
    background-color: var(--bg-crimson);
    border-bottom: 1px solid rgba(212, 175, 106, 0.5); /* Línea dorada horizontal */
    padding: 1.2rem 3rem;
    position: relative;
    z-index: 10;
}

.nav-container {
    max-width: 1300px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

/* Caja con borde dorado para el nombre (como FORÇA en la referencia) */
.brand-box {
    border: 1px solid var(--gold);
    padding: 0.6rem 1.2rem;
    text-decoration: none;
    color: var(--gold);
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: all 0.3s ease;
}

.brand-box:hover {
    background-color: rgba(212, 175, 106, 0.1);
}

.brand-name {
    font-size: 1.15rem;
    letter-spacing: 3px;
    font-weight: 500;
}

.brand-symbol {
    font-size: 0.9rem;
    margin-top: 2px;
    color: var(--gold-light);
}

/* Enlaces del menú */
.nav-links {
    display: flex;
    gap: 2rem;
}

.nav-links a {
    color: var(--gold);
    text-decoration: none;
    font-size: 1.15rem;
    letter-spacing: 0.5px;
    transition: color 0.3s ease;
}

.nav-links a:hover,
.nav-links a.active {
    color: var(--ivory);
}

.nav-socials {
    display: flex;
    gap: 1.2rem;
}

.nav-socials a {
    color: var(--gold);
    text-decoration: none;
    font-size: 1.1rem;
    transition: color 0.3s;
}

.nav-socials a:hover {
    color: var(--ivory);
}

/* --- HERO / PORTADA CON FOTO --- */
.hero {
    min-height: 78vh;
    background-size: cover;
    background-position: center 25%;
    background-color: var(--bg-darker);
    display: flex;
    align-items: center;
    padding: 4rem 10%;
    border-bottom: 1px solid rgba(212, 175, 106, 0.4);
}

.hero-content {
    max-width: 650px;
}

.hero h1 {
    font-size: 4.5rem;
    font-weight: 400;
    line-height: 1.05;
    color: var(--ivory);
    margin-bottom: 0.5rem;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.6);
}

.hero-subtitle {
    font-size: 2.2rem;
    font-weight: 400;
    line-height: 1.2;
    color: var(--ivory);
    text-shadow: 0 2px 15px rgba(0, 0, 0, 0.6);
}

.hero-subtitle em {
    font-style: italic;
    color: var(--gold-light);
}

/* --- SECCIONES Y GALERÍA --- */
.main-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 5rem 2rem;
}

.section-header {
    text-align: center;
    margin-bottom: 4rem;
}

.ornament {
    color: var(--gold);
    font-size: 1.4rem;
    display: block;
    margin-bottom: 0.5rem;
}

.section-header h2 {
    font-size: 2.8rem;
    font-weight: 400;
    color: var(--ivory);
}

.section-header p {
    color: var(--text-muted);
    font-size: 1.2rem;
    margin-top: 0.5rem;
}

.gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2.5rem;
}

.work-item {
    border: 1px solid rgba(212, 175, 106, 0.35);
    background-color: var(--bg-darker);
    transition: transform 0.3s ease, border-color 0.3s ease;
}

.work-item:hover {
    border-color: var(--gold);
    transform: translateY(-4px);
}

.work-image {
    width: 100%;
    height: 360px;
    overflow: hidden;
    background-color: #1a0203;
}

.work-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
}

.work-item:hover .work-image img {
    transform: scale(1.04);
}

.work-info {
    padding: 1.8rem;
}

.work-year {
    display: block;
    font-size: 0.95rem;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.4rem;
}

.work-info h3 {
    font-size: 1.6rem;
    font-weight: 500;
    margin-bottom: 0.75rem;
    color: var(--ivory);
}

.work-info p {
    color: var(--text-muted);
    font-size: 1.1rem;
}

/* --- SEMBLANZA --- */
.bio-section {
    margin-top: 6rem;
    padding: 4rem 2rem;
    border-top: 1px solid rgba(212, 175, 106, 0.4);
    border-bottom: 1px solid rgba(212, 175, 106, 0.4);
    text-align: center;
}

.bio-container {
    max-width: 750px;
    margin: 0 auto;
}

.bio-container h2 {
    font-size: 2.6rem;
    font-weight: 400;
    margin-bottom: 1.5rem;
}

.bio-container p {
    font-size: 1.25rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
}

.btn-gold {
    display: inline-block;
    padding: 0.8rem 2rem;
    border: 1px solid var(--gold);
    color: var(--gold);
    text-decoration: none;
    font-size: 1.1rem;
    letter-spacing: 1px;
    transition: all 0.3s ease;
}

.btn-gold:hover {
    background-color: var(--gold);
    color: var(--bg-darker);
}

/* --- PIE DE PÁGINA --- */
.footer {
    padding: 3rem 2rem;
    text-align: center;
    color: var(--text-muted);
    font-size: 1.05rem;
}

.footer-links {
    margin-top: 0.8rem;
    display: flex;
    justify-content: center;
    gap: 1rem;
}

.footer-links a {
    color: var(--gold);
    text-decoration: none;
}

/* --- RESPONSIVO PARA CELULARES --- */
@media (max-width: 850px) {
    .navbar { padding: 1.2rem; }
    .nav-container { flex-direction: column; gap: 1.2rem; }
    .nav-links { flex-wrap: wrap; justify-content: center; gap: 1rem; }
    .hero { min-height: 60vh; padding: 3rem 1.5rem; }
    .hero h1 { font-size: 3.2rem; }
    .hero-subtitle { font-size: 1.7rem; }
}
